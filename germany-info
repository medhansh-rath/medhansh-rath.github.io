<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Germany Survival Guide - Medhansh Rath</title>

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: '#4f46e5', dark: '#0f172a', surface: '#1e293b' },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- html2pdf.js for PDF Generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body class="bg-dark text-slate-300 antialiased selection:bg-primary selection:text-white min-h-screen">

    <div class="max-w-3xl mx-auto px-6 py-12 md:py-20">
        
        <!-- Navigation Back Link -->
        <a href="../index.html#about" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-indigo-400 mb-10 transition">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Main Page
        </a>

        <!-- Article Container for PDF Export -->
        <div id="downloadable-article">

            <!-- Article Header -->
            <header class="mb-10 pb-8 border-b border-slate-800">
                <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
                    <span class="bg-primary/20 text-primary px-2.5 py-1 rounded-full font-semibold uppercase tracking-wider">Living in Germany</span>
                    <span>•</span>
                    <time datetime="2026-09-25">September 25, 2026</time>
                    <span>•</span>
                    <span>4 min read</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
                    The Ultimate Moving to Germany Guide
                </h1>
                <p class="mt-4 text-lg text-slate-400 leading-relaxed">
                    Everything you need to know about finding an apartment, getting a SIM card, navigating public transit, and buying groceries without getting scammed.
                </p>

                <!-- Download Actions Toolbar -->
                <div id="article-actions" class="flex flex-wrap items-center gap-3 mt-6 pt-4 border-t border-slate-800/60">
                    <!-- Download Source File -->
                    <a href="germany-guide.html" download="Germany_Survival_Guide_Medhansh_Rath.html" class="inline-flex items-center gap-2 text-xs font-semibold bg-surface hover:bg-slate-700 text-slate-200 hover:text-white px-3.5 py-2 rounded-lg border border-slate-700 transition shadow-sm">
                        <i data-lucide="download" class="w-4 h-4 text-primary"></i> Download HTML
                    </a>
                    <!-- Export as PDF -->
                    <button onclick="downloadPagePDF()" class="inline-flex items-center gap-2 text-xs font-semibold bg-surface hover:bg-slate-700 text-slate-200 hover:text-white px-3.5 py-2 rounded-lg border border-slate-700 transition shadow-sm">
                        <i data-lucide="file-text" class="w-4 h-4 text-primary"></i> Export as PDF
                    </button>
                </div>
            </header>

            <!-- Main Article Content -->
            <article class="space-y-6 text-slate-300 leading-relaxed text-base">
                
                <h2 class="text-2xl font-bold text-white">Housing & Apartments</h2>
                <p>
                    Finding a place to live is usually the hardest part. Depending on what you are looking for, here are the platforms you should be using:
                </p>
                <ul class="list-disc pl-5 space-y-2 text-sm mb-4">
                    <li><strong>Full Apartments:</strong> Use <span class="text-indigo-400 font-semibold">Immoscout</span> or <span class="text-indigo-400 font-semibold">Immowelt</span>.</li>
                    <li><strong>Shared Apartments (WGs):</strong> <span class="text-indigo-400 font-semibold">WG-Gesucht</span> is the absolute standard.</li>
                    <li><strong>Other options:</strong> Facebook groups and WhatsApp communities are heavily used for housing handovers.</li>
                </ul>

                <blockquote class="border-l-4 border-red-500 pl-4 my-6 italic text-slate-200 bg-surface/40 py-3 pr-4 rounded-r-lg">
                    <strong class="text-red-400 not-italic">⚠️ Crucial Warning:</strong> There are many scams going on. <strong>Do not pay anything</strong> and <strong>do not send your ID</strong> until you are absolutely sure it is not a scam. Never pay a deposit before seeing the apartment in person and signing a contract.
                </blockquote>

                <h2 class="text-2xl font-bold text-white pt-4">Phones, SIM Cards & Internet</h2>
                <p>
                    When setting up your digital life, your best friend is <strong class="text-white">Check24</strong>. You can use it to compare the best prices for SIM cards, WiFi, insurance, and more.
                </p>
                
                <div class="space-y-3 text-sm">
                    <div class="p-3 bg-surface/30 rounded-lg border border-slate-800">
                        <strong class="text-indigo-400 block mb-1">Network Providers (Best to Worst):</strong>
                        1. Telekom &nbsp;|&nbsp; 2. Vodafone &nbsp;|&nbsp; 3. O2 &nbsp;|&nbsp; 4. Drillisch
                    </div>
                </div>
                
                <p>
                    <strong>Pro tip:</strong> Don't buy directly from the big three (Telekom, Vodafone, O2) as their direct plans are very expensive. Instead, search on Check24 and filter for the "Telekom" or "Vodafone" network. You will find third-party providers offering the same coverage for much cheaper. 
                </p>
                <p>
                    People use WiFi everywhere here, so you really don't need a massive data plan. Don't get anything that costs more than €10 a month.
                </p>

                <h2 class="text-2xl font-bold text-white pt-4">Transport & Apps</h2>
                <ul class="list-disc pl-5 space-y-2 text-sm">
                    <li><strong>Tickets:</strong> Look into the <em>Deutschlandticket</em>. If you are a student, check if you are eligible for the <a href="https://www.mvg.de/abos-tickets/abos/ermaessigungsticket.html" target="_blank" class="text-indigo-400 hover:underline">Ermäßigungsticket (Discounted Ticket)</a>.</li>
                    <li><strong>DB Navigator:</strong> The absolute must-have app for trains and public transit. <a href="https://play.google.com/store/apps/details?id=de.hafas.android.db" target="_blank" class="text-indigo-400 hover:underline">Download it here</a>.</li>
                    <li><strong>Buying Second-Hand:</strong> Need cheap furniture or a bike? <a href="https://play.google.com/store/apps/details?id=com.ebay.kleinanzeigen" target="_blank" class="text-indigo-400 hover:underline">Kleinanzeigen</a> is the German equivalent of Craigslist/Gumtree.</li>
                </ul>

                <h2 class="text-2xl font-bold text-white pt-4">Banking & Daily Life</h2>
                <ul class="list-disc pl-5 space-y-2 text-sm mb-4">
                    <li><strong>Bank Accounts:</strong> Skip the traditional slow banks and open an account with <strong>N26</strong> or <strong>Revolut</strong>. It's much faster and English-friendly.</li>
                    <li><strong>Price Comparisons:</strong> Use <strong>Idealo</strong> before buying any electronics or physical goods to ensure you get the best price.</li>
                    <li><strong>Travel:</strong> Use <strong>Booking.com</strong> for hotels, but always cross-reference with Check24 first to see if there are better prices available.</li>
                </ul>

                <h2 class="text-2xl font-bold text-white pt-4">Groceries & Cooking</h2>
                <p>
                    If you cook Asian or Indian food, you don't need to panic about basics. <strong>Every German supermarket</strong> carries basmati rice and cooking oil. 
                </p>
                <p>
                    For specifics like daal and proper spices, you can easily find them at local Indian or Asian grocery stores. However, if you have extra space in your luggage, it's not a bad idea to carry some of your favorite spices from home to get you started!
                </p>

            </article>

            <!-- Footer / Author Bio -->
            <footer class="mt-16 pt-8 border-t border-slate-800 flex items-center justify-between">
                <div>
                    <p class="text-white font-bold">Written by Medhansh Rath</p>
                </div>
                <a href="../index.html#booking" class="bg-surface hover:bg-slate-700 text-white text-xs font-semibold px-4 py-2 rounded-lg border border-slate-700 transition">
                    Book a Chat
                </a>
            </footer>

        </div>

    </div>

    <!-- Scripts -->
    <script>
        lucide.createIcons();

        // PDF Generation Script optimized for article pages
        function downloadPagePDF() {
            const container = document.getElementById('downloadable-article');
            const clone = container.cloneNode(true);
            
            // Remove download toolbar for clean PDF export
            const actions = clone.querySelector('#article-actions');
            if (actions) actions.remove();

            // Set clean white background for standard printing
            clone.style.padding = '24px';
            clone.style.backgroundColor = '#ffffff';
            clone.style.color = '#1f2937';

            // Convert dark theme colors to print-friendly tones
            const lightTexts = clone.querySelectorAll('.text-white, .text-slate-300, .text-slate-400');
            lightTexts.forEach(el => el.style.color = '#111827');

            const borders = clone.querySelectorAll('.border-slate-800, .border-slate-800\\/60');
            borders.forEach(el => el.style.borderColor = '#e5e7eb');

            const options = {
                margin: [0.5, 0.5, 0.5, 0.5],
                filename: 'Germany_Survival_Guide_Medhansh_Rath.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            };

            html2pdf().set(options).from(clone).save();
        }
    </script>
</body>
</html>

